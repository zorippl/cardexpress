{
  "name": "card-express",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "description": "摄影师的 RAW / JPG 存储卡归档工具",
  "author": { "name": "zori", "email": "876229130@qq.com" },
  "main": "electron/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:zip": "npm run build && electron-builder --mac zip --arm64 --x64 --config.mac.identity=null --config.mac.notarize=false --publish never",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "exiftool-vendored": "^39.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.cardexpress.desktop",
    "productName": "CardExpress",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asarUnpack": ["node_modules/exiftool-vendored*/**/*"],
    "mac": { "category": "public.app-category.photography", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
